# GlobalHealth Unified System
# Copia este archivo a .env y ajusta los valores segun tu entorno local.

# --- Aplicacion (backend) ---
APP_NAME=GlobalHealth_Unified_System
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- PostgreSQL (primario / replica) ---
POSTGRES_HOST=postgres-primary
POSTGRES_PORT=5432
POSTGRES_DB=globalhealth
POSTGRES_USER=globalhealth
POSTGRES_PASSWORD=change-me
POSTGRES_REPLICA_HOST=postgres-replica
POSTGRES_REPLICA_PORT=5432
POSTGRES_REPLICATION_USER=globalhealth_replicator
POSTGRES_REPLICATION_PASSWORD=change-replication-me
POSTGRES_WRITE_URL=postgresql://globalhealth:change-me@postgres-primary:5432/globalhealth
POSTGRES_READ_URL=postgresql://globalhealth:change-me@postgres-replica:5432/globalhealth

# --- MongoDB ---
# Desarrollo local sin credenciales. Para Atlas, reemplaza el valor en .env.
MONGODB_URI=mongodb://mongodb:27017/globalhealth
MONGODB_DB=globalhealth

# --- Fragmentacion vertical ---
FRAGMENT_PUBLIC_DB=globalhealth_public
FRAGMENT_FINANCIAL_DB=globalhealth_financial
FRAGMENT_COORDINATOR_DB=globalhealth
FRAGMENT_FDW_PASSWORD=change-me
