# GlobalHealth Unified System
# Copia este archivo a .env y ajusta los valores segun tu entorno local.

# --- Aplicacion (backend) ---
APP_NAME=GlobalHealth_Unified_System
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# --- Frontend / CORS ---
# Origenes permitidos para el navegador, separados por comas.
# No usar '*' en produccion.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL (primario / replica) ---
POSTGRES_DB=globalhealth
POSTGRES_USER=globalhealth
POSTGRES_PASSWORD=change-me
POSTGRES_REPLICATION_USER=globalhealth_replicator
POSTGRES_REPLICATION_PASSWORD=change-replication-me

# --- MongoDB ---
# local: mongodb://mongodb:27017/globalhealth
# atlas: mongodb+srv://<username>:<password>@<cluster>/globalhealth
MONGODB_PROVIDER=local
MONGODB_URI=mongodb://mongodb:27017/globalhealth
MONGODB_DB=globalhealth

# --- Fragmentacion vertical ---
FRAGMENT_PUBLIC_DB=globalhealth_public
FRAGMENT_FINANCIAL_DB=globalhealth_financial
FRAGMENT_COORDINATOR_DB=globalhealth
FRAGMENT_FDW_PASSWORD=change-me

# --- Fragmentacion horizontal ---
FRAGMENT_NORTH_DB=globalhealth_north
FRAGMENT_SOUTH_DB=globalhealth_south
FRAGMENT_HORIZONTAL_COORDINATOR_DB=globalhealth_horizontal
FRAGMENT_HORIZONTAL_FDW_PASSWORD=change-me
