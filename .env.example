# GlobalHealth Unified System
# Copia este archivo a .env y ajusta los valores segun tu entorno local.

# --- Aplicacion (backend) ---
APP_NAME=GlobalHealth_Unified_System
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- PostgreSQL (primario / replica) ---
# Nota: la replica se habilitara en una fase posterior.
POSTGRES_HOST=postgres-primary
POSTGRES_PORT=5432
POSTGRES_DB=globalhealth
POSTGRES_USER=globalhealth
POSTGRES_PASSWORD=change-me
POSTGRES_REPLICA_HOST=postgres-replica
POSTGRES_REPLICA_PORT=5432
POSTGRES_REPLICA_USER=globalhealth_replica
POSTGRES_REPLICA_PASSWORD=change-me

# --- MongoDB ---
# Nota: MongoDB se habilitara en una fase posterior.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=globalhealth
MONGO_USER=globalhealth
MONGO_PASSWORD=change-me
